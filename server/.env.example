# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Claude API (for OCR)
ANTHROPIC_API_KEY=sk-ant-...

# Server
PORT=3001
NODE_ENV=development

# Photo import (OCR) is limited to these Google accounts. Comma separated. Use * to allow any signed-in user.
OCR_ALLOWED_EMAILS=you@gmail.com,spouse@gmail.com

# Browsers may only call this API from these sites (comma separated). Defaults to the GitHub Pages site and local dev.
ALLOWED_ORIGINS=https://testingrino.github.io,http://localhost:8080

# Photo import is rate limited per signed-in user (defaults shown)
OCR_HOURLY_LIMIT=20
OCR_DAILY_LIMIT=60

# Optional: forward anonymous product events (landed, setup_finished, ...) to a webhook such as PostHog or a Google Sheet script
ANALYTICS_WEBHOOK_URL=

# Accounts mode (Supabase). With these set, photo import accepts Supabase sign-in tokens as well as Google ones.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: where photo-import waitlist sign-ups (email + planner brand) are forwarded. They are always written to the log too.
WAITLIST_WEBHOOK_URL=

# Admin and licensing (see DEPLOY.md). The service-role key bypasses row-level security: server only, never in js/config.js.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=you@example.com

# Subscriptions (Stripe). SITE_URL is where people return after checkout.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PLUS=
STRIPE_WEBHOOK_SECRET=
SITE_URL=https://testingrino.github.io/LifeOS/
